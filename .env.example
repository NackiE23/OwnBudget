# Скопіюйте у .env і заповніть. Файл .env не комітиться.

# Локально: 1. На хостингу: 0 (тоді DJANGO_SECRET_KEY обов'язковий).
DJANGO_DEBUG=1
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# На PythonAnywhere: https://<логін>.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Нестандартний шлях до адмінки, наприклад my-budget-a7f3/
DJANGO_ADMIN_URL=admin/
# Необов'язково: інший шлях до бази
# DJANGO_SQLITE_PATH=
